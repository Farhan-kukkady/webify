    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14"
  },
  "keywords": [
    "agency",
    "angular",
    "tailwindcss",
    "express",
    "typescript"
